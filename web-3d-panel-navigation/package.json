{
  "name": "@scupit/web-3d-panel-navigation",
  "version": "0.6.0",
  "description": "Fullscreen viewport-owned 3D panel navigation with Three.js CSS3D and clip-path content reveals, plus an optional WebGL skybox layer.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/base.css",
    "./dist/engine.css",
    "./dist/example-theme.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./render-contract": {
      "types": "./src/render-contract/index.ts",
      "import": "./dist/render-contract.js"
    },
    "./lite-backend": {
      "types": "./src/backends/lite/index.ts",
      "import": "./dist/lite-backend.js"
    },
    "./three-backend": {
      "types": "./src/backends/three/index.ts",
      "import": "./dist/three-backend.js"
    },
    "./base.css": "./dist/base.css",
    "./engine.css": "./dist/engine.css",
    "./example-theme.css": "./dist/example-theme.css"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "example:build": "pnpm run build && node ./scripts/build-example.mjs",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.182.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "sass": "^1.89.2",
    "three": "^0.182.0",
    "typescript": "^6.0.3"
  }
}
