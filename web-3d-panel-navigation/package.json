  "scripts": {
    "build": "node ./scripts/build.mjs",
    "example:build": "npm run build && node ./scripts/build-example.mjs"
  },
  "peerDependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
