{
  "name": "Files MCP",
  "slug": "files",
  "scope_profile": "standard",
  "extra_scopes": [
    "files.index",
    "files.delete"
  ],
  "auth0": {
    "create_api_if_missing": true
  },
  "grants": {
    "client_groups": [
      "interactive-default"
    ],
    "client_overrides": {
      "sync-worker": [
        "tools.read",
        "files.index"
      ]
    }
  },
  "access_policy": {
    "user": "require_client_grant",
    "client": "deny_all"
  }
}
