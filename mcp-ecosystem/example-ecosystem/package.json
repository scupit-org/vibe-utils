{
  "name": "example-ecosystem",
  "version": "0.1.0",
  "description": "Example MCP ecosystem with working Git and Files servers",
  "private": true,
  "type": "module",
  "scripts": {
    "pm2:start:http_stateless": "pm2 start ecosystem.config.cjs --only mcp-git,mcp-files,mcp-all-in-one --env http_stateless",
    "pm2:start:http_stateful": "pm2 start ecosystem.config.cjs --only mcp-live-monitor --env http_stateful",
    "pm2:start:stdio": "pm2 start ecosystem.config.cjs --only mcp-git,mcp-files,mcp-all-in-one,mcp-live-monitor --env stdio",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@scupit/mcp-ecosystem": "file:..",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "pm2": "^6.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
