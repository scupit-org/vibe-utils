{
  "name": "@scupit/mcp-ecosystem",
  "version": "0.2.4",
  "description": "Provisioning and runtime tooling for a personal MCP ecosystem that uses Auth0 for OAuth",
  "license": "MIT", 
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/mcp-server/index.js",
      "types": "./dist/mcp-server/index.d.ts"
    }
  },
  "bin": {
    "mcp-ecosystem": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/auth-middleware.test.ts tests/config-resolution.test.ts tests/env-remediation.test.ts tests/transport-selection.test.ts tests/teardown-server.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scupit-org/vibe-utils.git",
    "directory": "mcp-ecosystem"
  },
  "keywords": [
    "mcp",
    "auth0",
    "oauth",
    "provisioning"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.11.0",
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "express": "^4.21.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.2"
  }
}
